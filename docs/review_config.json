{
 "_comment": "minipc-power. Currents at the 15 W design budget on a 3.0 V cell (5.6 A from the pack): 12 V boost input 2.2 A, 5 V boost input 2.6 A, 3.3 V buck-boost input 0.8 A. Output runs at each rail's rated current. VBUS at the 2 A input limit.",
 "ground_nets": [
  "GND"
 ],
 "net_classes": [
  {
   "match": "^Net-\\((U4-SW|C4-Pad2|C24-Pad2|U6-L1|U6-L2|U2-BTST|U4-BST|U5-BOOT)\\)$",
   "class": "switch"
  },
  {
   "match": "^Net-\\((U4-FB|U5-FB|U6-FB|U4-COMP|U5-COMP|C13-Pad1|C28-Pad1|U4-ILIMIT|U5-ILIM|U2-ILIM|U2-ICHG|U4-FREQ/SYNC|U5-FSW|U5-SS|U2-TS|U3-CS|U3-VDD)\\)$",
   "class": "analog"
  },
  {
   "match": "^Net-\\(J1-CC[12]\\)$",
   "class": "cc"
  },
  {
   "match": "^/EN$|^Net-\\(J9-Pad1\\)$|PG|Net-\\(C36-Pad1\\)|Net-\\(LED1-K\\)",
   "class": "slow_ext"
  },
  {
   "match": "^(\\+|VBUS|VSYS|BAT)|3V3|5V|12V|Net-\\((Q4-S|Q5-S|F1-Pad1|J3-Pad1|U3-VSS|Q2-D-Pad1|U2-PMID)\\)",
   "class": "power"
  }
 ],
 "fast_classes": [
  "switch",
  "analog",
  "cc"
 ],
 "diff_pairs": [],
 "rail_voltages": {
  "VSYS": 4.35,
  "BAT": 4.35,
  "VBUS": 9,
  "Net-(Q4-S)": 12,
  "Net-(Q5-S)": 5
 },
 "hot_loops": [
  {
